rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return currentUserDoc().data;
    }

    function hasUserProfile() {
      return signedIn() && currentUserDoc().exists();
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isFarmMember(farmId) {
      return hasUserProfile() && currentUserData().farmId == farmId;
    }

    function isAdmin() {
      return hasUserProfile() && currentUserData().role == "ADMIN";
    }

    function isAdminForFarm(farmId) {
      return isFarmMember(farmId) && isAdmin();
    }

    function isDairyOperatorForFarm(farmId) {
      return isFarmMember(farmId) &&
        (currentUserData().role == "ADMIN" || currentUserData().role == "DAIRY_MAN");
    }

    function isOperationalStaffForFarm(farmId) {
      return isFarmMember(farmId) &&
        (currentUserData().role == "ADMIN" ||
         currentUserData().role == "DAIRY_MAN" ||
         currentUserData().role == "LABOUR");
    }

    match /users/{userId} {
      allow create: if isSelf(userId);
      allow read, update: if isSelf(userId);
      allow delete: if false;
    }

    match /user_provisioning_requests/{requestId} {
      allow create: if hasUserProfile() &&
        (currentUserData().role == "ADMIN" || currentUserData().role == "DAIRY_MAN");
      allow read: if hasUserProfile() &&
        resource.data.farmId == currentUserData().farmId;
      allow update, delete: if false;
    }

    match /farms/{farmId} {
      allow create: if isAdmin() &&
        request.resource.data.adminUserId == request.auth.uid;
      allow read, update: if isFarmMember(farmId);
      allow delete: if false;

      match /livestock/{animalId} {
        allow read: if isFarmMember(farmId);
        allow write: if isOperationalStaffForFarm(farmId);
      }

      match /khata/{documentId} {
        allow read: if isFarmMember(farmId);
        allow write: if isDairyOperatorForFarm(farmId);

        match /transactions/{transactionId} {
          allow read: if isFarmMember(farmId);
          allow write: if isDairyOperatorForFarm(farmId);
        }
      }

      match /dashboard/{snapshotId} {
        allow read: if isFarmMember(farmId);
        allow write: if isAdminForFarm(farmId);
      }

      match /alerts/{alertId} {
        allow read: if isFarmMember(farmId);
        allow write: if isOperationalStaffForFarm(farmId);
      }

      match /analytics/{docId} {
        allow read: if isFarmMember(farmId);
        allow write: if isAdminForFarm(farmId);
      }

      match /staff/{staffId} {
        allow read: if isFarmMember(farmId);
        allow write: if isAdminForFarm(farmId);
      }

      match /config/{docId} {
        allow read: if isFarmMember(farmId);
        allow write: if isAdminForFarm(farmId);

        match /land_partitions/{partitionId} {
          allow read: if isFarmMember(farmId);
          allow write: if isAdminForFarm(farmId);
        }
      }

      match /inventory/{docId} {
        allow read: if isFarmMember(farmId);
        allow write: if isOperationalStaffForFarm(farmId);

        match /items/{itemId} {
          allow read: if isFarmMember(farmId);
          allow write: if isOperationalStaffForFarm(farmId);
        }

        match /feed_batches/{batchId} {
          allow read: if isFarmMember(farmId);
          allow write: if isOperationalStaffForFarm(farmId);
        }
      }

      match /outer_center/{docId} {
        allow read: if isFarmMember(farmId);
        allow write: if isDairyOperatorForFarm(farmId);

        match /collections/{collectionId} {
          allow read: if isFarmMember(farmId);
          allow write: if isDairyOperatorForFarm(farmId);
        }

        match /notifications/{notificationId} {
          allow read: if isFarmMember(farmId);
          allow write: if isDairyOperatorForFarm(farmId);
        }
      }
    }
  }
}
